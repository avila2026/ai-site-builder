{
  "name": "ai-site-builder",
  "version": "0.1.0",
  "description": "AI Site Builder - Crie sites inteligentes com IA",
  "author": "AI Site Builder Team",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "stitch:smoke": "node scripts/stitch-smoke.mjs",
    "vercel:preflight": "node scripts/vercel-preflight.mjs",
    "analyze": "ANALYZE=true next build",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "node scripts/build-electron.js && electron-builder",
    "electron:build:uninstaller": "node scripts/build-uninstaller-launcher.js",
    "electron:build:win": "node scripts/build-electron.js && electron-builder --win && node scripts/build-uninstaller-launcher.js",
    "electron:pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "main": "electron/main.js",
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.13.0",
    "@browserbasehq/sdk": "^2.9.0",
    "@google/stitch-sdk": "^0.1.0",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "next": "15.5.14",
    "node-fetch": "^3.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.14",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  }
}
