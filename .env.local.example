# AI Site Builder - Environment Variables
# Copie este arquivo para .env.local e ajuste os valores
#
# Vercel Project ID: prj_GOPqthxRaYOgVQB1n6uAzr6CbJCX

# URL da aplicação (opcional)
# NEXT_PUBLIC_APP_URL=https://seusite.com

# Ollama Configuration
OLLAMA_MODEL=qwen3.5:cloud

# URL do Ollama (opcional - padrão: http://localhost:11434)
# Descomente e ajuste se o Ollama estiver em outro endereço
# OLLAMA_BASE_URL=http://localhost:11434

# Autonoma API Credentials (obrigatório para testes)
# Obtenha em https://autonoma.app/settings/api
AUTONOMA_CLIENT_ID="seu-client-id"
AUTONOMA_SECRET_ID="seu-secret-id"

# AI Gateway API Keys (opcional)
# v1 - Vercel AI Gateway
AI_GATEWAY_API_KEY="sua-api-key"
# BYOK - Bring Your Own Key (fallback automático entre providers)
AI_GATEWAY_BYOK="seu-byok-key"

# BrowserBase (Browser Automation)
# Depois de rodar `vercel link`, execute `vercel pull` para trazer esses segredos localmente
BROWSERBASE_API_KEY="sua-api-key"
BROWSERBASE_PROJECT_ID="seu-project-id"

# Neon Postgres
DATABASE_URL="postgresql://usuario:senha@host/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/database?sslmode=require"

# Auth0 para Next.js
AUTH0_DOMAIN="seu-tenant.us.auth0.com"
AUTH0_CLIENT_ID="seu-client-id"
AUTH0_CLIENT_SECRET="seu-client-secret"
AUTH0_SECRET="gere-com-openssl-rand-hex-32"
# Opcional em preview; o SDK consegue inferir em runtime se omitido
APP_BASE_URL="http://localhost:3000"

# Node.js memory limit (opcional)
# NODE_OPTIONS=--max-old-space-size=4096
